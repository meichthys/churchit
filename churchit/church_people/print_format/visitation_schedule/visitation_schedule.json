 "html": "<style>\n  @page { size: Letter; margin: 14mm; }\n  body { font-family: Arial, sans-serif; font-size: 10pt; color: #222; }\n  h1 { margin: 0; font-size: 18pt; }\n  .meta { color: #666; margin-bottom: 12px; font-size: 9pt; }\n  .row { border: 1px solid #ddd; border-radius: 4px; padding: 10px 12px; margin: 8px 0; page-break-inside: avoid; }\n  .who { font-weight: bold; font-size: 11pt; }\n  .when { color: #555; font-size: 9pt; margin: 4px 0; }\n  .tag { display: inline-block; background: #2a4a85; color: white; padding: 1px 8px; border-radius: 8px; font-size: 8pt; }\n  .followup { background: #faf7f0; border-left: 4px solid #c0392b; padding: 6px 10px; margin-top: 6px; font-size: 9pt; }\n</style>\n<h1>Visitation Schedule</h1>\n<div class=\"meta\">Pastoral visit record · {{ frappe.utils.formatdate(frappe.utils.nowdate(), \"MMMM d, yyyy\") }}</div>\n\n<div class=\"row\">\n  <div class=\"who\">{{ frappe.db.get_value(\"Person\", doc.person, \"full_name\") }}</div>\n  <div class=\"when\">\n    <span class=\"tag\">{{ doc.visit_type }}</span>\n    <span class=\"tag\">{{ doc.status }}</span>\n    {{ frappe.utils.formatdate(doc.visit_date, \"EEEE, MMMM d\") }}\n    {% if doc.visited_by %} · Visited by {{ frappe.db.get_value(\"Person\", doc.visited_by, \"full_name\") }}{% endif %}\n    {% if doc.duration_minutes %} · {{ doc.duration_minutes }} min{% endif %}\n  </div>\n  <div>{{ doc.notes }}</div>\n  {% if doc.follow_up_needed %}\n  <div class=\"followup\">\n    <strong>Follow-up needed</strong>\n  </div>\n  {% endif %}\n</div>\n",
