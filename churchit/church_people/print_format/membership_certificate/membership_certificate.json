 "html": "<style>\n  @page { size: Letter landscape; margin: 12mm; }\n  body { font-family: \"Garamond\", \"Times New Roman\", serif; color: #222; }\n  .cert { border: 6px double #6b3b1f; padding: 32px; text-align: center; }\n  .title { font-size: 38px; font-weight: bold; letter-spacing: 3px; color: #6b3b1f; text-transform: uppercase; margin-bottom: 4px; }\n  .sub { font-size: 16px; font-style: italic; color: #888; margin-bottom: 24px; }\n  .body-text { font-size: 17px; line-height: 1.8; margin-bottom: 16px; }\n  .name { font-size: 30px; font-weight: bold; font-family: \"Brush Script MT\", cursive; margin: 12px 0; }\n  .verse { font-style: italic; font-size: 13px; color: #555; margin-top: 24px; }\n  .signature-row { display: flex; justify-content: space-around; margin-top: 48px; font-size: 12px; }\n  .signature-row .sig { border-top: 1px solid #444; padding-top: 4px; width: 220px; text-align: center; }\n</style>\n<div class=\"cert\">\n  <div class=\"title\">Certificate of Membership</div>\n  <div class=\"sub\">Welcome to the Family of Faith</div>\n  <div class=\"body-text\">This certifies that</div>\n  <div class=\"name\">{{ doc.full_name }}</div>\n  <div class=\"body-text\">\n    was received into membership at {{ frappe.db.get_value(\"Church\", {\"parent_church\": [\"is\", \"not set\"]}, \"church_name\") or \"our church\" }} on the\n    {% set _mem = (doc.life_events or []) | selectattr(\"event_type\", \"equalto\", \"Membership\") | sort(attribute=\"date\") | first %}\n    {% set _md = _mem.date if _mem else None %}\n    <strong>{{ frappe.utils.formatdate(_md, \"dd\") if _md else \"____\" }}</strong> day of\n    <strong>{{ frappe.utils.formatdate(_md, \"MMMM\") if _md else \"____________\" }}</strong>,\n    <strong>{{ frappe.utils.formatdate(_md, \"yyyy\") if _md else \"____\" }}</strong>.\n  </div>\n  <div class=\"verse\">\"So then you are no longer strangers and aliens, but you are fellow citizens with the saints and members of the household of God.\" - Ephesians 2:19</div>\n  <div class=\"signature-row\">\n    <div class=\"sig\">Pastor</div>\n    <div class=\"sig\">Church Clerk</div>\n  </div>\n</div>\n",
