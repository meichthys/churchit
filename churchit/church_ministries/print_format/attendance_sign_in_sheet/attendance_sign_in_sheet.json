 "html": "<style>\n  @page { size: Letter; margin: 12mm; }\n  body { font-family: Arial, sans-serif; font-size: 11pt; color: #222; }\n  h1 { margin: 0 0 6px 0; font-size: 18pt; }\n  .meta { color: #666; margin-bottom: 12px; }\n  table { width: 100%; border-collapse: collapse; }\n  th, td { border: 1px solid #888; padding: 6px 8px; text-align: left; }\n  th { background: #f4f4f4; }\n  .row-num { width: 30px; text-align: center; color: #999; }\n  .sig { width: 220px; }\n  .blank { height: 30px; }\n</style>\n<h1>Attendance Sign-In</h1>\n<div class=\"meta\">\n  <strong>{{ doc.function_name }}</strong><br>\n  {{ frappe.utils.formatdate(doc.start_date, \"EEEE, MMMM d, yyyy\") if doc.start_date else \"\" }}\n  {% if doc.address %} · {{ doc.address }}{% endif %}\n</div>\n<table>\n  <thead>\n    <tr>\n      <th class=\"row-num\">#</th>\n      <th>Name</th>\n      <th>Family</th>\n      <th class=\"sig\">Signature</th>\n      <th>Visitor?</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for a in doc.attendance %}\n      <tr>\n        <td class=\"row-num\">{{ loop.index }}</td>\n        <td>{{ frappe.db.get_value(\"Person\", a.person, \"full_name\") }}</td>\n        <td>{{ frappe.db.get_value(\"Family\", frappe.db.get_value(\"Person\", a.person, \"family\"), \"family_name\") or \"\" }}</td>\n        <td class=\"sig\">&nbsp;</td>\n        <td>&nbsp;</td>\n      </tr>\n    {% endfor %}\n    {% for _ in range(20) %}\n      <tr class=\"blank\"><td class=\"row-num\">&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>\n    {% endfor %}\n  </tbody>\n</table>\n",
