 "html": "<style>\n  @page { size: Letter; margin: 18mm; }\n  body { font-family: \"Georgia\", serif; font-size: 12pt; color: #222; line-height: 1.5; }\n  h1 { margin: 0 0 4px 0; font-size: 22pt; color: #2a4a85; }\n  .speaker { color: #666; font-size: 11pt; font-style: italic; margin-bottom: 16px; }\n  .scripture { background: #faf7f0; border-left: 4px solid #c8a96a; padding: 10px 14px; margin: 14px 0; font-style: italic; }\n  .notes { white-space: pre-wrap; margin-top: 18px; font-size: 11pt; line-height: 1.6; }\n  hr { border: none; border-top: 1px solid #ddd; margin: 18px 0; }\n</style>\n<h1>{{ doc.title }}</h1>\n<div class=\"speaker\">\n  {% if doc.prepared_by %}Prepared by {{ frappe.db.get_value(\"Person\", doc.prepared_by, \"full_name\") }}{% endif %}\n</div>\n\n{% set presentations = frappe.db.get_all(\"Sermon Presentation\", filters={\"sermon\": doc.name}, fields=[\"date\", \"location\"], order_by=\"date desc\", limit=1) %}\n{% if presentations %}\n  <div class=\"speaker\">Most recently preached: {{ frappe.utils.formatdate(presentations[0].date) }}{% if presentations[0].location %} · {{ presentations[0].location }}{% endif %}</div>\n{% endif %}\n\n<hr>\n\n<div class=\"notes\">{{ doc.notes or \"\" }}</div>\n",
