 "client_script": "// Auto-populate church and person for new sign-ups\nvar church_ctrl = frappe.web_form.fields_dict['church'];\nvar person_ctrl = frappe.web_form.fields_dict['person'];\n\nif (!frappe.web_form.doc.name) {\n\tif (church_ctrl) {\n\t\tfrappe.call({\n\t\t\tmethod: 'frappe.client.get_value',\n\t\t\targs: { doctype: 'User', filters: { name: frappe.session.user }, fieldname: 'church' },\n\t\t\tcallback: function(r) {\n\t\t\t\tif (r.message && r.message.church) {\n\t\t\t\t\tchurch_ctrl.set_value(r.message.church);\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t}\n\n\tif (person_ctrl) {\n\t\tfrappe.call({\n\t\t\tmethod: 'church.church_ministries.web_form.function_sign_up.function_sign_up.get_person_for_user',\n\t\t\tcallback: function(r) {\n\t\t\t\tif (r.message) {\n\t\t\t\t\tperson_ctrl.set_value(r.message);\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t}\n}\n",
