  "client_script": "var church_ctrl = frappe.web_form.fields_dict['church'];\nvar person_ctrl = frappe.web_form.fields_dict['person'];\n\nfrappe.call({\n\tmethod: 'church.church_ministries.web_form.function_sign_up.function_sign_up.get_user_context',\n\tcallback: function(r) {\n\t\tif (!r.message) return;\n\t\tvar ctx = r.message;\n\n\t\tif (!frappe.web_form.doc.name) {\n\t\t\tif (church_ctrl && ctx.church) {\n\t\t\t\tchurch_ctrl.set_value(ctx.church);\n\t\t\t}\n\t\t\tif (person_ctrl && ctx.person) {\n\t\t\t\tperson_ctrl.set_value(ctx.person);\n\t\t\t}\n\t\t}\n\n\t\tif (!ctx.is_manager) {\n\t\t\tif (church_ctrl) church_ctrl.$wrapper.hide();\n\t\t\tif (person_ctrl) person_ctrl.$wrapper.hide();\n\t\t}\n\t}\n});\n",
