 "html": "<style>\n  @page { size: Letter; margin: 12mm; }\n  body { font-family: \"Georgia\", serif; font-size: 11pt; color: #222; }\n  .header { text-align: center; border-bottom: 2px solid #2a4a85; padding-bottom: 12px; margin-bottom: 18px; }\n  .header h1 { font-size: 26pt; color: #2a4a85; margin: 0 0 4px 0; }\n  .header .date { font-size: 12pt; color: #666; font-style: italic; }\n  h2 { font-size: 14pt; color: #2a4a85; border-bottom: 1px solid #eee; padding-bottom: 4px; margin-top: 18px; }\n  .order { margin-left: 16px; }\n  .order .item { margin: 4px 0; display: flex; }\n  .order .item .label { width: 220px; font-weight: bold; }\n  .verse { background: #faf7f0; border-left: 4px solid #c8a96a; padding: 10px 14px; font-style: italic; margin: 16px 0; }\n  .footer { margin-top: 24px; font-size: 9pt; color: #888; border-top: 1px solid #eee; padding-top: 8px; text-align: center; }\n</style>\n<div class=\"header\">\n  <h1>{{ doc.function_name }}</h1>\n  <div class=\"date\">\n    {% if doc.start_date %}{{ frappe.utils.formatdate(doc.start_date, \"EEEE, MMMM d, yyyy\") }}{% endif %}\n    {% if doc.start_time %} · {{ doc.start_time }}{% endif %}\n  </div>\n</div>\n\n{% if doc.description %}\n<div class=\"verse\">{{ doc.description }}</div>\n{% endif %}\n\n{% if doc.schedule %}\n<h2>Order of Service</h2>\n<div class=\"order\">\n  {% for s in doc.schedule %}\n    <div class=\"item\"><div class=\"label\">{{ s.item or s.idx }}</div><div>{{ s.description or \"\" }}</div></div>\n  {% endfor %}\n</div>\n{% endif %}\n\n<div class=\"footer\">\n  We're glad you're worshipping with us today.\n</div>\n",
