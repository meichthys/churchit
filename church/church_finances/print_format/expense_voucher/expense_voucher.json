 "html": "<style>\n  @page { size: Letter; margin: 18mm; }\n  body { font-family: Arial, sans-serif; font-size: 10pt; color: #222; }\n  h1 { margin: 0; font-size: 18pt; }\n  .meta { color: #666; margin-bottom: 14px; }\n  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; margin: 12px 0 20px; }\n  .grid .label { color: #888; font-size: 9pt; text-transform: uppercase; }\n  .amount { font-size: 22pt; color: #2a4a85; font-weight: bold; }\n  .signatures { margin-top: 36px; }\n  .signatures .row { display: flex; gap: 36px; margin: 18px 0; }\n  .signatures .sig { flex: 1; border-top: 1px solid #444; padding-top: 4px; font-size: 9pt; }\n</style>\n<h1>Expense Voucher / Check Request</h1>\n<div class=\"meta\">{{ doc.name }} · {{ frappe.utils.formatdate(doc.date or frappe.utils.nowdate()) }}</div>\n\n<div class=\"amount\">{{ frappe.utils.fmt_money(doc.amount or 0) }}</div>\n\n<div class=\"grid\">\n  <div><div class=\"label\">Paid To</div>{{ doc.paid_to or doc.vendor or \"—\" }}</div>\n  <div><div class=\"label\">Expense Type</div>{{ doc.type or \"—\" }}</div>\n  <div><div class=\"label\">Fund (GL)</div>{{ frappe.db.get_value(\"Fund\", doc.fund, \"fund\") if doc.fund else \"—\" }}</div>\n  <div><div class=\"label\">Ministry</div>{{ frappe.db.get_value(\"Ministry\", doc.ministry, \"ministry_name\") if doc.ministry else \"—\" }}</div>\n  <div><div class=\"label\">Check Number</div>{{ doc.check_number or \"—\" }}</div>\n  <div><div class=\"label\">Date</div>{{ frappe.utils.formatdate(doc.date) if doc.date else \"—\" }}</div>\n</div>\n\n<div><strong>Description:</strong> {{ doc.description or \"—\" }}</div>\n\n<div class=\"signatures\">\n  <div class=\"row\">\n    <div class=\"sig\">Requested By</div>\n    <div class=\"sig\">Date</div>\n  </div>\n  <div class=\"row\">\n    <div class=\"sig\">Approved By</div>\n    <div class=\"sig\">Date</div>\n  </div>\n  <div class=\"row\">\n    <div class=\"sig\">Treasurer</div>\n    <div class=\"sig\">Date</div>\n  </div>\n</div>\n",
