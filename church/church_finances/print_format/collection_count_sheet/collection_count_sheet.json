 "html": "<style>\n  @page { size: Letter; margin: 15mm; }\n  body { font-family: Arial, sans-serif; font-size: 10pt; color: #222; }\n  h1 { margin: 0; font-size: 18pt; }\n  .meta { color: #666; margin-bottom: 14px; }\n  table { width: 100%; border-collapse: collapse; margin: 8px 0; }\n  th, td { border: 1px solid #888; padding: 5px 8px; text-align: left; }\n  th { background: #f0f0f0; }\n  .num { text-align: right; }\n  .denom { width: 50%; vertical-align: top; }\n  .signature { margin-top: 32px; display: flex; gap: 40px; }\n  .sig { flex: 1; }\n  .sig .line { border-top: 1px solid #444; padding-top: 4px; font-size: 9pt; }\n</style>\n<h1>Collection Count Sheet</h1>\n<div class=\"meta\">\n  <strong>{{ doc.name }}</strong> · {{ frappe.utils.formatdate(doc.date, \"EEEE, MMMM d, yyyy\") }}\n  {% if doc.function %} · Function: {{ frappe.db.get_value(\"Function\", doc.function, \"title\") or doc.function }}{% endif %}\n</div>\n\n<table>\n  <thead>\n    <tr><th>Fund</th><th class=\"num\">Cash</th><th class=\"num\">Check</th><th class=\"num\">Other</th><th class=\"num\">Total</th></tr>\n  </thead>\n  <tbody>\n    {% for ft in doc.fund_totals or [] %}\n      <tr><td>{{ frappe.db.get_value(\"Fund\", ft.fund, \"fund\") or ft.fund }}</td><td class=\"num\">&nbsp;</td><td class=\"num\">&nbsp;</td><td class=\"num\">&nbsp;</td><td class=\"num\">{{ frappe.utils.fmt_money(ft.total or 0) }}</td></tr>\n    {% endfor %}\n    <tr><th>Total</th><th class=\"num\">&nbsp;</th><th class=\"num\">&nbsp;</th><th class=\"num\">&nbsp;</th><th class=\"num\">{{ frappe.utils.fmt_money(doc.total_amount or 0) }}</th></tr>\n  </tbody>\n</table>\n\n<table>\n  <thead>\n    <tr><th class=\"denom\">Cash Denomination Breakdown</th><th class=\"num\">Count</th><th class=\"num\">Total</th></tr>\n  </thead>\n  <tbody>\n    {% for line in [(\"$100 bills\",100),(\"$50 bills\",50),(\"$20 bills\",20),(\"$10 bills\",10),(\"$5 bills\",5),(\"$1 bills\",1),(\"Quarters\",0.25),(\"Dimes\",0.10),(\"Nickels\",0.05),(\"Pennies\",0.01)] %}\n      <tr><td>{{ line[0] }}</td><td class=\"num\">&nbsp;</td><td class=\"num\">&nbsp;</td></tr>\n    {% endfor %}\n  </tbody>\n</table>\n\n<div class=\"signature\">\n  <div class=\"sig\"><div class=\"line\">Counter 1 (Print &amp; Sign)</div></div>\n  <div class=\"sig\"><div class=\"line\">Counter 2 (Print &amp; Sign)</div></div>\n  <div class=\"sig\"><div class=\"line\">Date / Time</div></div>\n</div>\n",
