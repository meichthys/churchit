 "client_script": "var doc = frappe.web_form && frappe.web_form.doc;\nif (doc && doc.name) {\n\tvar $actions = $(\".web-form-header .web-form-actions\").first();\n\tif ($actions.length && !$actions.find(\".btn-create-prayer\").length) {\n\t\tvar $btn = $('<button type=\"button\" class=\"btn btn-primary btn-sm ml-2 btn-create-prayer\">' + __(\"Pray for this request\") + '</button>');\n\t\t$actions.append($btn);\n\t\t$btn.on(\"click\", function(e) {\n\t\t\te.preventDefault();\n\t\t\tvar d = new frappe.ui.Dialog({\n\t\t\t\ttitle: __(\"Pray for {0}\", [doc.title || doc.name]),\n\t\t\t\tfields: [\n\t\t\t\t\t{ fieldname: \"content\", fieldtype: \"Small Text\", label: __(\"Prayer\") }\n\t\t\t\t],\n\t\t\t\tprimary_action_label: __(\"Save Prayer\"),\n\t\t\t\tprimary_action: function(values) {\n\t\t\t\t\tfrappe.call({\n\t\t\t\t\t\tmethod: \"church.church_prayers.api.create_prayer\",\n\t\t\t\t\t\targs: { prayer_request: doc.name, content: values.content || null },\n\t\t\t\t\t\tfreeze: true,\n\t\t\t\t\t\tcallback: function(r) {\n\t\t\t\t\t\t\tif (r.message) {\n\t\t\t\t\t\t\t\tfrappe.show_alert({ message: __(\"Prayer saved\"), indicator: \"green\" });\n\t\t\t\t\t\t\t\td.hide();\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t});\n\t\t\td.show();\n\t\t});\n\t}\n}\n"
