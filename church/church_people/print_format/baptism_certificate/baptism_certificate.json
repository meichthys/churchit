 "html": "<style>\n  @page { size: Letter landscape; margin: 12mm; }\n  body { font-family: \"Garamond\", \"Times New Roman\", serif; color: #2a2a2a; }\n  .cert { border: 8px double #2a4a85; padding: 36px; text-align: center; }\n  .title { font-size: 42px; font-weight: bold; letter-spacing: 4px; color: #2a4a85; margin-bottom: 4px; text-transform: uppercase; }\n  .sub { font-size: 18px; color: #777; font-style: italic; margin-bottom: 24px; }\n  .body-text { font-size: 18px; line-height: 1.8; margin-bottom: 24px; }\n  .name { font-size: 32px; font-weight: bold; font-family: \"Brush Script MT\", cursive; margin: 16px 0; }\n  .verse { font-style: italic; font-size: 14px; color: #555; margin-top: 32px; }\n  .signature-row { display: flex; justify-content: space-around; margin-top: 56px; font-size: 12px; }\n  .signature-row .sig { border-top: 1px solid #444; padding-top: 4px; width: 220px; text-align: center; }\n</style>\n<div class=\"cert\">\n  <div class=\"title\">Certificate of Baptism</div>\n  <div class=\"sub\">In the name of the Father, and of the Son, and of the Holy Spirit</div>\n  <div class=\"body-text\">This certifies that</div>\n  <div class=\"name\">{{ doc.full_name }}</div>\n  {% set baptism = (doc.life_events or []) | selectattr(\"event_type\", \"equalto\", \"Baptism\") | first %}\n  <div class=\"body-text\">\n    was baptized on the\n    <strong>{{ frappe.utils.formatdate(baptism.date, \"dd\") if baptism else \"____\" }}</strong> day of\n    <strong>{{ frappe.utils.formatdate(baptism.date, \"MMMM\") if baptism else \"____________\" }}</strong>,\n    <strong>{{ frappe.utils.formatdate(baptism.date, \"yyyy\") if baptism else \"____\" }}</strong>\n    at {{ (baptism.location if baptism else None) or frappe.db.get_value(\"Church\", {\"parent_church\": [\"is\", \"not set\"]}, \"church_name\") or \"____________\" }}.\n  </div>\n  <div class=\"verse\">\"Therefore we are buried with him by baptism into death: that like as Christ was raised up from the dead by the glory of the Father, even so we also should walk in newness of life.\" - Romans 6:4</div>\n  <div class=\"signature-row\">\n    <div class=\"sig\">Officiant</div>\n    <div class=\"sig\">Witness</div>\n  </div>\n</div>\n",
